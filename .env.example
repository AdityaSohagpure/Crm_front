# PORT & ENVIRONMENT
PORT=5000
NODE_ENV=development
APP_URL=https://crm.centegix.com

# DATABASE (PostgreSQL) & REDIS QUEUES
DATABASE_URL="postgresql://postgres:password@localhost:5432/centegix_crm?schema=public"
REDIS_URL="redis://localhost:6379"

# META GRAPH API & WHATSAPP CLOUD API CONFIG
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="centegix_secure_verify_token_2026"
META_PERMANENT_ACCESS_TOKEN="EAAG_centegix_system_user_permanent_token_2026"
WHATSAPP_PHONE_NUMBER_ID="105938201928471"
WHATSAPP_BUSINESS_ACCOUNT_ID="109283746591029"

# FACEBOOK & INSTAGRAM CONFIG
FACEBOOK_PAGE_ID="102938475610293"
INSTAGRAM_ACCOUNT_ID="17841401293849201"

# EMAIL SERVICES CONFIG (Resend / SendGrid / AWS SES)
EMAIL_PROVIDER="Resend" # Options: Resend, SendGrid, AWS_SES, Custom_SMTP
RESEND_API_KEY="re_123456789_centegix_prod_key"
DEFAULT_FROM_NAME="Centegix Sales & Billing"
DEFAULT_FROM_EMAIL="sales@centegix.com"
